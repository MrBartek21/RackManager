HOST=0.0.0.0
PORT=3000
DEMO_MODE=true
UPDATE_INTERVAL_MS=2000
DEVICE_OFFLINE_TIMEOUT_MS=30000

# MultiMax RS-485 UART and transceiver direction pin (RS_REDE = GP18).
MULTIMAX_PORT=/dev/serial0
MULTIMAX_BAUD_RATE=115200
MULTIMAX_GATEWAY_ADDRESS=0
MULTIMAX_REDE_GPIO=18

# BCM pin mapping from the RackManager pinout provided for this installation.
RACKMANAGER_RELAY1_GPIO=23
RACKMANAGER_RELAY2_GPIO=22
RACKMANAGER_RELAY_ACTIVE_LOW=false
RACKMANAGER_GPIO_COMMAND=pinctrl
