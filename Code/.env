# SERVER
HOST=0.0.0.0
PORT=8080

# SYSTEM
UPDATE_INTERVAL_MS=2000

# MULTIMAX
MULTIMAX_PORT=/dev/serial0
MULTIMAX_BAUD_RATE=115200
MULTIMAX_GATEWAY_ADDRESS=0
MULTIMAX_REDE_GPIO=18
DEVICE_OFFLINE_TIMEOUT_MS=30000

# GPIO
GPIO_CHIP=/dev/gpiochip0

# DOOR
DOOR_GPIO=25

POWER_BTN_GPIO=24
POWER_LED_GPIO=5
OK_LED_GPIO=6
ACT_LED_GPIO=13

# RELAYS
RELAY1_GPIO=23
RELAY2_GPIO=22
RELAY_ACTIVE_LOW=false

# TM1637
TM_DIO_GPIO=27
TM_CLK_GPIO=16

# BUZZER
BUZZER_GPIO=12
BUZZER_ACTIVE_LOW=false